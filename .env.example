# PostHog product analytics (optional). Without a key, analytics is a no-op.
# The project key is a public, write-only ingestion key; it is set in Vercel, not committed.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Better Stack error tracking (optional, Sentry-compatible DSN; public by design).
# Without it, errors go to PostHog only. Set in Vercel for Production, not committed.
NEXT_PUBLIC_BETTER_STACK_ERRORS_DSN=
